{
  "name": "enlidea-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "pregenerate:api": "node -e \"const fs = require('fs'); if (!fs.existsSync('openapi.yml')) { console.error('\\x1b[31mError: Schema not found. You must generate the schema first.\\x1b[0m'); process.exit(1); }\"",
    "predev": "npm run generate:api",
    "prebuild": "npm run generate:api",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "pretest": "npm run generate:api",
    "test": "vitest",
    "preview": "vite preview",
    "generate:api": "orval"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.23",
    "axios": "^1.7.2",
    "katex": "^0.16.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.25.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "use-debounce": "^10.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "orval": "^7.13.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.4"
  }
}
