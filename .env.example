# --- Enlidea Environment Configuration Example ---
# Copy this file to .env (`cp .env.example .env`) and fill in appropriate values for your environment.
# Variables marked [Optional for Development] have defaults when DEBUG=True or when running locally outside Docker.
# All variables marked [Required in Production] must be explicitly set when deploying to production (DEBUG=False).

# =====================================================================
# 1. Django Core & Security
# =====================================================================
# [Required] Secret key for Django cryptographic signing (generate a secure random string of 50+ chars)
SECRET_KEY=your-django-secret-key-here

# [Required] Set to False in production, True for local development
DEBUG=True

# [Required for Docker/Prod] Specifies the Django settings file to load
# Options: 'enlidea.settings.development' or 'enlidea.settings.production'
DJANGO_SETTINGS_MODULE=enlidea.settings.development

# [Required] Comma-separated list of allowed hostnames (use exact domain name(s) or server IP in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# [Required] Comma-separated list of CORS allowed origins where requests to the API can originate
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# [Required] Custom URL path for the Django Admin portal (use an obfuscated path like 'secure-admin-portal/' in production)
ADMIN_URL=admin/

# [Required] Secret key for JWT signing and internal email token signing (generate a secure random string)
SIGNING_KEY=your-jwt-signing-key-here

# [Optional for Production] TLS / SSL Security Overrides
# Defaults to True in production. Only set to False if testing production Docker builds locally over plain HTTP without SSL/TLS.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000



# =====================================================================
# 2. Database Configuration (PostgreSQL)
# =====================================================================
# [Required] Database name
DB_NAME=enlidea

# [Required] Database username
DB_USER=postgres

# [Required] Database password
DB_PASS=your-database-password

# [Required] Database host ('localhost' when running local Python outside Docker, 'db' when running via Docker Compose)
DB_HOST=localhost

# [Required] Database port (typically 5432)
DB_PORT=5432

# [Optional] Full PostgreSQL connection URL override.
# When running with Docker Compose, if omitted, it is automatically composed from DB_USER, DB_PASS, DB_HOST/db, and DB_NAME.
# DATABASE_URL=postgres://postgres:your-database-password@db:5432/enlidea


# =====================================================================
# 3. Redis & Celery Task Queue
# =====================================================================
# [Required] Password for the Redis server.
# Required by docker-compose.yml when launching Redis and Celery containers.
# Passwords placed into connection URLs should optimally be URL-safe (alphanumeric, -, _, ., ~)
REDIS_PASSWORD=your-secure-redis-password

# [Required] Broker connection URL for Celery task dispatching.
# Local development without Docker auth: redis://localhost:6379/0
# Docker Compose setup: redis://:your-secure-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# [Required] Result backend URL for Celery task monitoring and output storage.
# Local development without Docker auth: redis://localhost:6379/0
# Docker Compose setup: redis://:your-secure-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# =====================================================================
# 4. Treasury, System Identity & Public Pool
# =====================================================================
# [Optional for Development (defaults to treasury@enlidea.com) - Required in Production]
# Email address assigned to the automated System Treasury account created by `setup_system`
TREASURY_EMAIL=treasury@enlidea.system

# [Optional for Development (generates random key if omitted) - Required in Production]
# API key assigned to the automated Treasury Orchestrator agent created by `setup_system`
TREASURY_AGENT_KEY=your-secure-treasury-agent-key-here

# [Optional for Development (defaults to public_pool@enlidea.com) - Required in Production]
# Email address assigned to the anonymous Public Pool maintainer account created by `setup_system`
PUBLIC_POOL_EMAIL=public_pool@enlidea.com


# =====================================================================
# 5. Email Service (SMTP Notification Engine)
# =====================================================================
# [Required] SMTP username/email address used to send verification and password reset emails
EMAIL_HOST_USER=your-email@gmail.com

# [Required] SMTP application password
EMAIL_HOST_PASSWORD=your-smtp-app-password

# [Required] Public URL of the frontend application where activation and reset email links should direct users
FRONTEND_URL=http://localhost:5173


# =====================================================================
# 6. MCP Server & Frontend Client Configuration
# =====================================================================
# [Optional for Development (defaults to http://backend:8000 inside Docker) - Required in Production if customized]
# Base URL where the MCP server connects to the backend API inside the container network
ENLIDEA_BACKEND_URL=http://backend:8000

# [Optional for Development (defaults to http://frontend:5173 inside Docker) - Required in Production if customized]
# Base URL where the MCP server fetches skill documentation from the frontend container
ENLIDEA_FRONTEND_URL=http://frontend:5173

# [Required] Base URL for the backend API.
# When running local dev (`npm run dev` or `override.yml`), set to http://localhost:8000.
# When building for production (`docker compose build`), set to relative path "" or your production API domain (e.g., https://yourdomain.com).
VITE_API_BASE_URL=http://localhost:8000

# [Required] Base URL for the FastMCP server.
# When running local dev (`npm run dev` or `override.yml`), set to http://localhost:8001.
# When building for production (`docker compose build`), set to relative path "" or your production MCP origin (e.g., https://mcp.yourdomain.com).
VITE_MCP_URL=http://localhost:8001

# [Optional] Production Container Image Version Tags (for reproducible builds and CI/CD rollbacks)
# BACKEND_IMAGE=enlidea-backend:1.1.0
# FRONTEND_IMAGE=enlidea-frontend:1.1.0
# MCP_IMAGE=enlidea-mcp:1.1.0




