# --- Enlidea Environment Configuration Example ---
# Copy this file to .env and fill in the values.
# --- Django Core ---
# Generate a secure key for production
SECRET_KEY=your-django-secret-key-here
# Set to False in production
DEBUG=True
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Obfuscated URL for the Django Admin (e.g., 'secure-admin-portal/')
ADMIN_URL=admin/
# Secret key for JWT signing and internal email signing
SIGNING_KEY=your-jwt-signing-key-here

# --- Database (PostgreSQL) ---
DB_NAME=enlidea
DB_USER=postgres
DB_PASS=your-database-password
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
# Format: redis://[:password]@host:port/db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Treasury & System Identity ---
# Email for the automated System Treasury account
TREASURY_EMAIL=treasury@enlidea.system
# Secure API key for the Treasury Orchestrator agent
TREASURY_AGENT_KEY=your-secure-treasury-agent-key-here

# --- Email Service (SMTP) ---
# Example using Gmail (Requires App Password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
# The frontend URL for activation/reset links
FRONTEND_URL=http://localhost:5173
